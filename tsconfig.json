{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,
    // CM-27 — "noUnusedLocals" et "noUnusedParameters" restent DÉSACTIVÉS,
    // volontairement. Les activer fait sortir 58 erreurs TS6133/TS6196, toutes
    // dans src/** : imports d'icônes laissés derrière un composant retiré,
    // `const cup = await …` chargés puis jamais lus dans les gardes de
    // src/server/api/routers/jury.ts, `maxScale`/`maxScore` calculés avant le
    // passage à convertScoreToScale. Aucune n'est dans les fichiers d'outillage.
    // Or `pnpm typecheck` est la première étape du workflow de déploiement :
    // activer ces deux options sans corriger les 58 sites d'un coup rendrait la
    // CI rouge et bloquerait le déploiement jusqu'à la dernière correction.
    // Le nettoyage se fait donc fichier par fichier, dans les lots qui possèdent
    // src/**, et ces deux lignes s'ajoutent une fois la liste vidée — la liste
    // complète est dans le compte rendu du lot outillage.

    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2022"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts"
  ],
  // scripts/ n'est plus exclu : ces fichiers écrivent en base (import
  // historique, suppression de comptes) et une colonne renommée dans le
  // schéma Drizzle ne se voyait qu'à l'exécution contre la base cible.
  // public/ reste exclu : il ne contient que des assets et des scripts de
  // navigateur (sw.js, widget/embed.js) que checkJs analyserait à tort avec
  // les lib DOM+Node de l'application.
  "exclude": ["node_modules", "generated", "public"]
}
