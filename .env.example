# ================================================================
# Platinum CBD Cup - Environment variables
# Copy to `.env` and fill in real values before starting the app.
# ================================================================

# ---------- Database ----------
# Postgres connection string. Container uses platinum-postgres:5432 internally.
DATABASE_URL="postgresql://platinum:change-me@platinum-postgres:5432/platinum_cbd_cup"
# Only used by docker-compose to init the postgres container:
POSTGRES_USER="platinum"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="platinum_cbd_cup"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="https://platinumcbdcup.eu"

# ---------- Better Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-32+-random-bytes"
BETTER_AUTH_URL="https://platinumcbdcup.eu"

# ---------- Email (Resend) ----------
RESEND_API_KEY="re_..."
EMAIL_FROM="Platinum CBD Cup <noreply@platinumcbdcup.eu>"

# ---------- Viva.com / Viva Wallet (producer registration payments) ----------
# "demo" points at the Viva sandbox, "production" at the live platform.
VIVA_ENV="production"
# Settings > API Access — OAuth2 credentials used to create payment orders.
VIVA_CLIENT_ID=""
VIVA_CLIENT_SECRET=""
# Sales > Payment Sources — the source code whose success/failure redirect
# URLs are configured in the Viva back-office:
#   success: https://platinumcbdcup.eu/cups/{cupId}/register/success
#   failure: https://platinumcbdcup.eu/cups/{cupId}/register?cancelled=true
VIVA_SOURCE_CODE=""
# Settings > Security > API Keys — Basic-auth pair, needed only so the
# webhook endpoint can serve Viva its verification key.
VIVA_MERCHANT_ID=""
VIVA_API_KEY=""

# ---------- Runtime ----------
NODE_ENV="production"
